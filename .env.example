# Personal AI Assistant - environment template.
# Copy this file to .env and fill in real values. .env is gitignored - never commit it.

# Google Gemini API key (https://aistudio.google.com/apikey)
GEMINI_API_KEY=

# Zapier MCP token (Zapier MCP server in Managed mode)
ZAPIER_MCP_TOKEN=

# HMAC integrity secret for approval arguments (NOT transport auth - the
# browser is protected by the Host allowlist + CORS instead).
# Optional: if empty, an ephemeral random secret is generated per process.
# Generate one: python -c "import secrets; print(secrets.token_urlsafe(32))"
LOCAL_API_TOKEN=

# Primary Google Calendar ID (used by calendar tools when you do not name one).
# The model cannot guess opaque Zapier IDs, so this is injected into the system
# prompt at runtime. Find yours via the Zapier MCP list_dynamic_enum_values
# helper for any google_calendar_* tool + property "calendarid".
DEFAULT_CALENDAR_ID=

# Frontend -> API base URL (default is fine for localhost)
NEXT_PUBLIC_API_URL=http://localhost:8000

# Gemini models (defaults are the free-tier flash models)
GEMINI_MODEL=gemini-2.5-flash
GEMINI_MODEL_FALLBACK=gemini-2.5-flash-lite
